/*********************************************************************
*
*       Geehy_G32R501_ConnectCore
*
*       VERSION: 1.0.0
*
*       DATE:    2026-08-30
*
*/

/* DCS Zone1 Zone2 CSM password */
U32 Z1_CSM_Buff[4]=
{
    0xFFFFFFFF,       // DCS Zone1 CSMPSWD0
    0xFFFFFFDC,       // DCS Zone1 CSMPSWD1
    0xFFFFFFFF,       // DCS Zone1 CSMPSWD2
    0xFFFFFFFF        // DCS Zone1 CSMPSWD3
};
U32 Z2_CSM_Buff[4]=
{
    0xFFFFFFFF,       // DCS Zone2 CSMPSWD0
    0xFFFEDFFF,       // DCS Zone2 CSMPSWD1
    0xFFFFFFFF,       // DCS Zone2 CSMPSWD2
    0xFFFFFFFF        // DCS Zone2 CSMPSWD3
};

/*********************************************************************
*
*       ConfigTargetSettings
*
*       CoreSight AP map; preset Cortex-M55 for J-Link AP scan.
*
*/

int ConfigTargetSettings(void) {

    JLINK_SYS_Report("******************************************************");
    JLINK_SYS_Report("J-Link script: Geehy_G32R501_ConnectCore (Cortex-M52)");
    JLINK_SYS_Report("VERSION: 1.0.0");
    JLINK_SYS_Report("DATE:    2026-08-30");
    JLINK_SYS_Report("******************************************************");

    JLINK_CORESIGHT_AddAP(0x0, CORESIGHT_AHB_AP);
    JLINK_CORESIGHT_AddAP(0x1, CORESIGHT_AHB_AP);
    JLINK_CORESIGHT_AddAP(0x2, CORESIGHT_AHB_AP);
    JLINK_CORESIGHT_AddAP(0x3, CORESIGHT_APB_AP);

    JLINK_CORESIGHT_IndexAHBAPToUse = 0x0;

    JLINK_CPU = CORTEX_M55;  // Preset for J-Link AP scan (chip is Cortex-M52)

    return 0;
}

/*********************************************************************
*
*       _InitDAP / _AhbWriteU32
*
*       InitTarget only (no MEM_*). CSM: Z1 0x50024020, Z2 0x500240A0.
*       Custom CSM: edit Z1_CSM_Buff / Z2_CSM_Buff (same as r501_key.ini).
*
*/
__constant U32 _DP_CTRL_STAT_BIT_DBGPWRUPREQ = (1 << 30);
__constant U32 _DP_CTRL_STAT_BIT_SYSPWRUPREQ = (1 << 28);
__constant U32 _DP_CTRL_STAT_BIT_STICKYERR   = (1 << 5);

static int _InitDAP(void) {
    U32 v;
    int r;
    int t;

    JLINK_SYS_Report("-- InitDAP: power up...");
    v = _DP_CTRL_STAT_BIT_DBGPWRUPREQ | _DP_CTRL_STAT_BIT_SYSPWRUPREQ;
    if (JLINK_ActiveTIF == JLINK_TIF_JTAG) {
        v |= _DP_CTRL_STAT_BIT_STICKYERR;
    } else {
        JLINK_CORESIGHT_WriteDP(JLINK_CORESIGHT_DP_REG_ABORT, 0x1E);
    }
    JLINK_CORESIGHT_WriteDP(JLINK_CORESIGHT_DP_REG_CTRL_STAT, v);

    r = -1;
    t = JLINK_GetTime() + 500;
    do {
        r = JLINK_CORESIGHT_ReadDP(JLINK_CORESIGHT_DP_REG_CTRL_STAT);
        if (r == -1) {
            break;
        }
        v = r;
        if (v & (0xF << 28)) {
            r = 0;
            break;
        }
        if ((t - JLINK_GetTime()) <= 0) {
            break;
        }
    } while (1);

    if (r < 0) {
        JLINK_SYS_Report("-- InitDAP: PWRUPACK timeout / DP error");
        JLINK_SYS_Report1("-- CTRL/STAT=", v);
        return -1;
    }
    JLINK_SYS_Report1("-- InitDAP: CTRL/STAT OK ", v);

    v = (0 << 4) | (0 << 24);
    JLINK_CORESIGHT_WriteDP(JLINK_CORESIGHT_DP_REG_SELECT, v);
    v = (2 << 0) | (0 << 4) | (1 << 24) | (1 << 25) | (1 << 29);
    r = JLINK_CORESIGHT_WriteAP(JLINK_CORESIGHT_AP_REG_CTRL, v);
    if (r < 0) {
        JLINK_SYS_Report("-- InitDAP: CSW write failed");
        return -1;
    }
    return 0;
}

static int _AhbWriteU32(U32 Addr, U32 Data) {
    int r;

    r = JLINK_CORESIGHT_WriteAP(JLINK_CORESIGHT_AP_REG_ADDR, Addr);
    if (r < 0) {
        return -1;
    }
    r = JLINK_CORESIGHT_WriteAP(JLINK_CORESIGHT_AP_REG_DATA, Data);
    return r;
}

static void _Report_DCS_Keys(void) {
    JLINK_SYS_Report("********************************************************");
    JLINK_SYS_Report("DCS unlock: edit Z1_CSM_Buff / Z2_CSM_Buff in");
    JLINK_SYS_Report("Geehy_G32R501_ConnectCore.jlinkscript if OTP keys differ.");
    JLINK_SYS_Report("  Zone1 CSMPSWD0..3:");
    JLINK_SYS_Report1("    [0]=", Z1_CSM_Buff[0]);
    JLINK_SYS_Report1("    [1]=", Z1_CSM_Buff[1]);
    JLINK_SYS_Report1("    [2]=", Z1_CSM_Buff[2]);
    JLINK_SYS_Report1("    [3]=", Z1_CSM_Buff[3]);
    JLINK_SYS_Report("  Zone2 CSMPSWD0..3:");
    JLINK_SYS_Report1("    [0]=", Z2_CSM_Buff[0]);
    JLINK_SYS_Report1("    [1]=", Z2_CSM_Buff[1]);
    JLINK_SYS_Report1("    [2]=", Z2_CSM_Buff[2]);
    JLINK_SYS_Report1("    [3]=", Z2_CSM_Buff[3]);
    JLINK_SYS_Report("********************************************************");
}

static int _DCS_KEY_Setup_CS(void) {
    int r;

    _Report_DCS_Keys();
    JLINK_SYS_Report("-- CoreSight write Z1/Z2 CSM...");
    r = _AhbWriteU32(0x50024020, Z1_CSM_Buff[0]);
    if (r < 0) { return -1; }
    r = _AhbWriteU32(0x50024024, Z1_CSM_Buff[1]);
    if (r < 0) { return -1; }
    r = _AhbWriteU32(0x50024028, Z1_CSM_Buff[2]);
    if (r < 0) { return -1; }
    r = _AhbWriteU32(0x5002402C, Z1_CSM_Buff[3]);
    if (r < 0) { return -1; }
    r = _AhbWriteU32(0x500240A0, Z2_CSM_Buff[0]);
    if (r < 0) { return -1; }
    r = _AhbWriteU32(0x500240A4, Z2_CSM_Buff[1]);
    if (r < 0) { return -1; }
    r = _AhbWriteU32(0x500240A8, Z2_CSM_Buff[2]);
    if (r < 0) { return -1; }
    r = _AhbWriteU32(0x500240AC, Z2_CSM_Buff[3]);
    if (r < 0) { return -1; }
    JLINK_SYS_Report("-- CSM keys written via AHB-AP");
    return 0;
}

/*********************************************************************
*
*       InitTarget
*
*       DCS unlock before MEM_* (CPU auto-detect / flash probe).
*
*/
int InitTarget(void) {
    int r;
    U32 v;

    JLINK_SYS_Report(" ******* InitTarget ******* ");

    r = JLINK_CORESIGHT_Configure("");
    if (r < 0) {
        JLINK_SYS_Report("-- Configure(\"\") failed");
        return -1;
    }

    v = JLINK_CORESIGHT_ReadDP(JLINK_CORESIGHT_DP_REG_IDCODE);
    JLINK_SYS_Report1("-- DPIDR=", v);

    r = _InitDAP();
    if (r < 0) {
        return -1;
    }

    r = _DCS_KEY_Setup_CS();
    if (r < 0) {
        JLINK_SYS_Report("-- CSM write failed");
        return -1;
    }

    JLINK_CORESIGHT_CoreBaseAddr = 0xE000E000;
    JLINK_CPU = CORTEX_M55;

    JLINK_SYS_Report("-- InitTarget done");
    return 0;
}

/*********************************************************************
*
*       DCS_KEY_Setup
*
*       Write Zone1/Zone2 CSM via MEM_* (connect / reset path).
*
*/
void DCS_KEY_Setup(void)
{
    // DCS Zone1 CSM (G32R501 addresses)
    MEM_WriteU32(0x50024020, Z1_CSM_Buff[0]);
    MEM_WriteU32(0x50024024, Z1_CSM_Buff[1]);
    MEM_WriteU32(0x50024028, Z1_CSM_Buff[2]);
    MEM_WriteU32(0x5002402C, Z1_CSM_Buff[3]);

    // DCS Zone2 CSM
    MEM_WriteU32(0x500240A0, Z2_CSM_Buff[0]);
    MEM_WriteU32(0x500240A4, Z2_CSM_Buff[1]);
    MEM_WriteU32(0x500240A8, Z2_CSM_Buff[2]);
    MEM_WriteU32(0x500240AC, Z2_CSM_Buff[3]);
}

/*********************************************************************
*
*       SetupTarget
*
*       DCS unlock on connect (after MEM_* available).
*
*/
int SetupTarget(void)
{
    JLINK_SYS_Report(" ******* SetupTarget ******* ");
    _Report_DCS_Keys();
    JLINK_SYS_Report("Unlocking Zone1/Zone2...");
    DCS_KEY_Setup();

    return 0;
}

/*********************************************************************
*
*       AfterResetTarget
*
*       Re-unlock DCS; apply VTOR/FPU/OTP and peripheral init.
*
*/
int AfterResetTarget(void)
{
    DCS_KEY_Setup();  // Reset / program load re-locks DCS

    // Init configuration
    MEM_WriteU32(0xE000ED08, 0x10000000);
    MEM_WriteU32(0xE000ED88, MEM_ReadU32(0xE000ED88) | 0x0C);
    MEM_WriteU8(0x50010600, MEM_ReadU8(0x50010600) & 0xF0);
    MEM_WriteU16(0x50026452, MEM_ReadU16(0x50026452) | 0x68);
    MEM_WriteU32(0xE0059040, MEM_ReadU32(0xE0059040) | 0x01);
    MEM_WriteU32(0xE0059044, MEM_ReadU32(0xE0059044) | 0x01);
    MEM_WriteU32(0x50020074, 0x01);
    MEM_WriteU16(0x500264C0, 0x0001);
    if((MEM_ReadU32(0x50020B00) & 0x01) == 0x01)
    {
        MEM_WriteU32(0x50010830, MEM_ReadU32(0x50010830) | 0xFFFF);
    }

    // Startup configuration
    if((MEM_ReadU32(0x50020B00) & 0x03) == 0x03)
    {
        MEM_WriteU32(0x50010000, 0x00000900);
        MEM_WriteU32(0x50020844, 0x00000000);
        if(((MEM_ReadU32(0x0810B910) & 0xFF000000) >> 24) != 0x5A)
        {
            MEM_WriteU32(0x50020828, 18);
        }
        if(((MEM_ReadU32(0x0810B910) & 0xFF000000) >> 24) == 0x5A)
        {
            MEM_WriteU32(0x50020828, (MEM_ReadU32(0x0810B910) >> 0x08) & 0xFF);
        }
        if((MEM_ReadU32(0x0810B878) & 0xFF03) == 0x5A00)
        {
            MEM_WriteU32(0x500280D4, MEM_ReadU32(0x500280D4) | 0x8000);
        }
        if((MEM_ReadU32(0x0810B894) & 0xFFFF) == 0x5A5A)
        {
            MEM_WriteU32(0x50028024, MEM_ReadU32(0x0810B884));
            MEM_WriteU32(0x50028028, MEM_ReadU32(0x0810B888));
            MEM_WriteU32(0x5002801C, MEM_ReadU32(0x0810B88C));
            MEM_WriteU32(0x50028020, MEM_ReadU32(0x0810B890));
        }
        if(((MEM_ReadU32(0x0810B910) & 0xFF000000) >> 24) == 0x5A)
        {
            MEM_WriteU32(0x50021100, MEM_ReadU32(0x0810B910) & 0xF0000);
            MEM_WriteU32(0x50021104, MEM_ReadU32(0x0810B910) & 0xF0000);
            MEM_WriteU32(0x50020844, MEM_ReadU32(0x0810B910) & 0xFC);
        }
        if(((MEM_ReadU32(0x0810B910) & 0xFF000003) == 0x5A000003) && (MEM_ReadU32(0x5002082C) & 0x01))
        {
            MEM_WriteU32(0x5002081C, MEM_ReadU32(0x5002081C) | 0x02);
        }
    }
    MEM_WriteU32(0x50010000, 0x00000F00);

    // Device configuration
    MEM_WriteU32(0x50020510, MEM_ReadU32(0x0810B800));
    MEM_WriteU32(0x50020514, MEM_ReadU32(0x0810B804));
    MEM_WriteU32(0x50020524, MEM_ReadU32(0x0810B80C));
    MEM_WriteU32(0x5002052C, MEM_ReadU32(0x0810B814));
    MEM_WriteU32(0x50020530, MEM_ReadU32(0x0810B818));
    MEM_WriteU32(0x50020534, MEM_ReadU32(0x0810B81C));
    MEM_WriteU32(0x5002053C, MEM_ReadU32(0x0810B824));
    MEM_WriteU32(0x50020540, MEM_ReadU32(0x0810B828));
    MEM_WriteU32(0x50020544, MEM_ReadU32(0x0810B82C));
    MEM_WriteU32(0x50020548, MEM_ReadU32(0x0810B830));
    MEM_WriteU32(0x5002054C, MEM_ReadU32(0x0810B834));
    MEM_WriteU32(0x50020558, MEM_ReadU32(0x0810B840));
    MEM_WriteU32(0x5002055C, MEM_ReadU32(0x0810B844));
    MEM_WriteU32(0x50020564, MEM_ReadU32(0x0810B84C));
    MEM_WriteU32(0x50020568, MEM_ReadU32(0x0810B850));
    MEM_WriteU32(0x50020570, MEM_ReadU32(0x0810B858));
    MEM_WriteU32(0x50020574, MEM_ReadU32(0x0810B860));
    MEM_WriteU32(0x50020578, MEM_ReadU32(0x0810B864));
    MEM_WriteU32(0x5002057C, MEM_ReadU32(0x0810B868));
    MEM_WriteU32(0x50020580, MEM_ReadU32(0x0810B86C));
    MEM_WriteU32(0x50020584, MEM_ReadU32(0x0810B870));
    if(((MEM_ReadU32(0x0810B914) & 0xFF000000) >> 24) == 0x5A)
    {
        MEM_WriteU32(0x5002075C, MEM_ReadU32(0x0810B914));
    }

    // System init
    MEM_WriteU32(0x50024020, Z1_CSM_Buff[0]);
    MEM_WriteU32(0x50024024, Z1_CSM_Buff[1]);
    MEM_WriteU32(0x50024028, Z1_CSM_Buff[2]);
    MEM_WriteU32(0x5002402C, Z1_CSM_Buff[3]);
    MEM_WriteU32(0x500240A0, Z2_CSM_Buff[0]);
    MEM_WriteU32(0x500240A4, Z2_CSM_Buff[1]);
    MEM_WriteU32(0x500240A8, Z2_CSM_Buff[2]);
    MEM_WriteU32(0x500240AC, Z2_CSM_Buff[3]);

    MEM_WriteU32(0x20307F30, MEM_ReadU32(0x50010604));
    MEM_WriteU32(0x20307F34, MEM_ReadU32(0x50010650));
    MEM_WriteU32(0x20307F28, MEM_ReadU32(0x50010608));
    MEM_WriteU32(0x20307F2C, MEM_ReadU32(0x50010654));

    if(((MEM_ReadU32(0x50024014) & 0xFF000000) >> 24) == 0x5A)
    {
        if(((MEM_ReadU32(0x50024014) & 0x00000030) >> 4) == 0x0)
        {
            // Configure GPIO24 for Error Status Pin
            // Write to GPAMUX2
            MEM_WriteU32(0x40030010, MEM_ReadU32(0x40030010) & (~(0x03 << 16)));
            MEM_WriteU32(0x40030010, MEM_ReadU32(0x40030010) | (0x01 << 16));
            // Write to GPAGMUX2
            MEM_WriteU32(0x40030044, MEM_ReadU32(0x40030044) & (~(0x03 << 16)));
            MEM_WriteU32(0x40030044, MEM_ReadU32(0x40030044) | (0x03 << 16));
            // Lock GPIO24
            MEM_WriteU32(0x40030078, MEM_ReadU32(0x40030078) | (0x01 << 24));
        }
        else if(((MEM_ReadU32(0x50024014) & 0x00000030) >> 4) == 0x1)
        {
            // Configure GPIO28 for Error Status Pin
            // Write to GPAMUX2
            MEM_WriteU32(0x40030010, MEM_ReadU32(0x40030010) & (~(0x03 << 24)));
            MEM_WriteU32(0x40030010, MEM_ReadU32(0x40030010) | (0x01 << 24));
            // Write to GPAGMUX2
            MEM_WriteU32(0x40030044, MEM_ReadU32(0x40030044) & (~(0x03 << 24)));
            MEM_WriteU32(0x40030044, MEM_ReadU32(0x40030044) | (0x03 << 24));
            // Lock GPIO28
            MEM_WriteU32(0x40030078, MEM_ReadU32(0x40030078) | (0x01 << 28));
        }
        else if(((MEM_ReadU32(0x50024014) & 0x00000030) >> 4) == 0x2)
        {
            // Configure GPIO29 for Error Status Pin
            // Write to GPAMUX2
            MEM_WriteU32(0x40030010, MEM_ReadU32(0x40030010) & (~(0x03 << 26)));
            MEM_WriteU32(0x40030010, MEM_ReadU32(0x40030010) | (0x01 << 26));
            // Write to GPAGMUX2
            MEM_WriteU32(0x40030044, MEM_ReadU32(0x40030044) & (~(0x03 << 26)));
            MEM_WriteU32(0x40030044, MEM_ReadU32(0x40030044) | (0x03 << 26));
            // Lock GPIO29
            MEM_WriteU32(0x40030078, MEM_ReadU32(0x40030078) | (0x01 << 29));
        }
    }

    if((MEM_ReadU32(0x0810B914) & 0xFF) == 0x00)
    {
        MEM_WriteU32(0x40030018, 0xFFCFFFFF);
        MEM_WriteU32(0x40030098, 0x0F6001FF);
    }
    if((MEM_ReadU32(0x0810B914) & 0xFF) == 0x01)
    {
        MEM_WriteU32(0x40030018, 0xFFCFFFFF);
        MEM_WriteU32(0x40030098, 0x00607FFF);
    }
    if((MEM_ReadU32(0x0810B914) & 0xFF) == 0x02)
    {
        MEM_WriteU32(0x40030018, 0x31CF3FFF);
        MEM_WriteU32(0x40030098, 0x0000007B);
    }
    if((MEM_ReadU32(0x0810B914) & 0xFF) == 0x03)
    {
        MEM_WriteU32(0x40030018, 0x31CF3BFF);
        MEM_WriteU32(0x40030098, 0x0000007B);
    }
    if((MEM_ReadU32(0x0810B914) & 0xFF) == 0x04)
    {
        MEM_WriteU32(0x40030018, 0x310D30FF);
        MEM_WriteU32(0x40030098, 0x0000007B);
    }

    if((MEM_ReadU32(0x50020B00) & 0x03) == 0x03)
    {
        MEM_WriteU32(0x5002081C, MEM_ReadU32(0x5002081C) | 0x02);
        MEM_WriteU32(0x50020828, 0x00);
        MEM_WriteU32(0x50020844, 0x00);
    }

    if((MEM_ReadU32(0x0810BA00) & 0xFFFF) == 0xA5A5)
    {
        if((MEM_ReadU32(0x50020B00) & 0x03) == 0x03)
        {
            MEM_WriteU32(0x5002800C, MEM_ReadU32(0x0810BA04));
            MEM_WriteU32(0x50028000, MEM_ReadU32(0x0810BA08));
            MEM_WriteU32(0x50028004, MEM_ReadU32(0x0810BA0C));
        }
    }

    MEM_WriteU32(0x50020A78, MEM_ReadU32(0x50020A78) | 0x0F);
    MEM_WriteU32(0x50028010, MEM_ReadU32(0x0810BA5C));
    MEM_WriteU32(0x50028014, MEM_ReadU32(0x0810BA60));
    MEM_WriteU32(0x50028018, MEM_ReadU32(0x0810BA64));
    MEM_WriteU32(0x50028068, MEM_ReadU32(0x0810BA68));
    MEM_WriteU32(0x5002806C, MEM_ReadU32(0x0810BA6C));
    MEM_WriteU32(0x50028070, MEM_ReadU32(0x0810BA70));
    MEM_WriteU32(0x4002007C, MEM_ReadU32(0x0810BA10));
    MEM_WriteU32(0x4002047C, MEM_ReadU32(0x0810BA14));
    MEM_WriteU32(0x4002087C, MEM_ReadU32(0x0810BA18));
    MEM_WriteU16(0x40020076, MEM_ReadU16(0x0810BA1C));
    MEM_WriteU16(0x40020476, MEM_ReadU16(0x0810BA20));
    MEM_WriteU16(0x40020876, MEM_ReadU16(0x0810BA24));
    MEM_WriteU32(0x400200E0, MEM_ReadU32(0x0810BA28));
    MEM_WriteU32(0x400200E4, MEM_ReadU32(0x0810BA2C));
    MEM_WriteU32(0x400200E8, MEM_ReadU32(0x0810BA30));
    MEM_WriteU32(0x400204E0, MEM_ReadU32(0x0810BA34));
    MEM_WriteU32(0x400204E4, MEM_ReadU32(0x0810BA38));
    MEM_WriteU32(0x400204E8, MEM_ReadU32(0x0810BA3C));
    MEM_WriteU32(0x400208E0, MEM_ReadU32(0x0810BA40));
    MEM_WriteU32(0x400208E4, MEM_ReadU32(0x0810BA44));

    MEM_WriteU32(0x50020A84, MEM_ReadU32(0x50020A84) | 0x00030000);
    MEM_WriteU32(0x5000180C, (MEM_ReadU32(0x5000180C) & 0xFF00) | (MEM_ReadU32(0x0810BA50) & 0x00FF));
    MEM_WriteU32(0x50001C0C, (MEM_ReadU32(0x50001C0C) & 0xFF00) | (MEM_ReadU32(0x0810BA54) & 0x00FF));

    MEM_WriteU32(0x50020B00, MEM_ReadU32(0x50020B00) & (~(0x03 << 0)));

    // Disable and clear all NVIC interrupts
    MEM_WriteU32(0xE000E180, 0xFFFFFFFF);
    MEM_WriteU32(0xE000E184, 0xFFFFFFFF);
    MEM_WriteU32(0xE000E188, 0xFFFFFFFF);
    MEM_WriteU32(0xE000E18C, 0xFFFFFFFF);
    MEM_WriteU32(0xE000E190, 0xFFFFFFFF);
    MEM_WriteU32(0xE000E194, 0xFFFFFFFF);
    MEM_WriteU32(0xE000E198, 0xFFFFFFFF);
    MEM_WriteU32(0xE000E19C, 0xFFFFFFFF);
    MEM_WriteU32(0xE000E1A0, 0xFFFFFFFF);
    MEM_WriteU32(0xE000E1A4, 0xFFFFFFFF);
    MEM_WriteU32(0xE000E1A8, 0xFFFFFFFF);
    MEM_WriteU32(0xE000E1AC, 0xFFFFFFFF);
    MEM_WriteU32(0xE000E1B0, 0xFFFFFFFF);
    MEM_WriteU32(0xE000E1B4, 0xFFFFFFFF);
    MEM_WriteU32(0xE000E1B8, 0xFFFFFFFF);
    MEM_WriteU32(0xE000E1BC, 0xFFFFFFFF);
    MEM_WriteU32(0xE000E280, 0xFFFFFFFF);
    MEM_WriteU32(0xE000E284, 0xFFFFFFFF);
    MEM_WriteU32(0xE000E288, 0xFFFFFFFF);
    MEM_WriteU32(0xE000E28C, 0xFFFFFFFF);
    MEM_WriteU32(0xE000E290, 0xFFFFFFFF);
    MEM_WriteU32(0xE000E294, 0xFFFFFFFF);
    MEM_WriteU32(0xE000E298, 0xFFFFFFFF);
    MEM_WriteU32(0xE000E29C, 0xFFFFFFFF);
    MEM_WriteU32(0xE000E2A0, 0xFFFFFFFF);
    MEM_WriteU32(0xE000E2A4, 0xFFFFFFFF);
    MEM_WriteU32(0xE000E2A8, 0xFFFFFFFF);
    MEM_WriteU32(0xE000E2AC, 0xFFFFFFFF);
    MEM_WriteU32(0xE000E2B0, 0xFFFFFFFF);
    MEM_WriteU32(0xE000E2B4, 0xFFFFFFFF);
    MEM_WriteU32(0xE000E2B8, 0xFFFFFFFF);
    MEM_WriteU32(0xE000E2BC, 0xFFFFFFFF);

    MEM_WriteU32(0x50020000, 0xA5FFFFFF);

    return 0;
}

